# ====================================================================
# RepoMate Environment Configuration Template
# For the AI Agents That Learn Using Hindsight Hackathon
# ====================================================================

# Google Gemini API Keys (Multi-tier key separation)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_QUESTION=
GEMINI_API_KEY_QUERY=

# Hindsight Long-Term AI Memory Configuration
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=repomate

# MongoDB Database URI (for storing repository vector embeddings)
MONGODB_URI=mongodb://127.0.0.1:27017/repomate

# GitHub API Token (Optional for higher rate limits on repository indexing)
GITHUB_TOKEN=

# Server Port
PORT=8080
